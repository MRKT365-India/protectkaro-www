{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "protectkaro-www",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "keep_vars": true,
  "workers_dev": true,
  "observability": {
    "logs": { "enabled": true },
    "traces": { "enabled": false }
  },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "protectkaro-www"
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  "routes": [
    { "pattern": "protectkaro.com/*", "zone_name": "protectkaro.com" },
    { "pattern": "www.protectkaro.com/*", "zone_name": "protectkaro.com" }
  ]
}
